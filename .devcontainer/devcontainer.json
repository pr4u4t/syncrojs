{
  "name": "SyncroJS WSL development",
  "dockerComposeFile": [
    "../compose.yaml",
    "../compose.local-db.yaml",
    "compose.devtools.yaml"
  ],
  "service": "server",
  "runServices": [
    "server",
    "database"
  ],
  "workspaceFolder": "/usr/src/app",
  "workspaceMount": "source=${localWorkspaceFolder},target=/usr/src/app,type=bind",
  "overrideCommand": false,
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "SyncroJS"
    }
  },
  "remoteUser": "node",
  "remoteEnv": {
    "SHELL": "/bin/bash"
  },
  "shutdownAction": "stopCompose"
}
