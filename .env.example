SESSION_SECRET=replace-with-a-long-random-secret
PGHOST=postgres.example.internal
PGPORT=5432
PGDATABASE=postgres
PGUSER=syncrojs
PGPASSWORD=replace-with-database-password
# Zscaler root CA, needed only on Windows machines behind Zscaler; leave unset on Linux/macOS.
# Repo opened from WSL: use the WSL path, e.g. /mnt/c/certs/zscaler.crt
# Repo opened directly from Windows: use forward slashes, e.g. C:/certs/zscaler.crt
#EXTRA_CA_FILE=/mnt/c/certs/zscaler.crt
