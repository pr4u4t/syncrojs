# Copy to .env.production on the production host and replace every placeholder.
SESSION_SECRET=replace-with-a-long-random-secret

# External PostgreSQL server; no database container is started by production Compose.
PGHOST=db.example.internal
PGPORT=5432
PGDATABASE=syncro
PGUSER=syncrojs
PGPASSWORD=replace-with-database-password
PGCONNECT_TIMEOUT=3000
PGQUERY_TIMEOUT=5000

# SyncroC server reachable from the production host/container network.
SYNCRO_HOST=syncro.example.internal
SYNCRO_PORT=13000
SYNCRO_CONNECT_TIMEOUT=3000

# Public host port and image tag.
APP_PORT=80
IMAGE_TAG=latest

# Optional PEM CA bundle for TLS-inspecting proxies during image builds.
# EXTRA_CA_FILE=/absolute/path/to/corporate-ca.pem
