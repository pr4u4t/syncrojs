# syntax=docker/dockerfile:1

FROM node:20.18-alpine3.20

RUN --mount=type=secret,id=extra_ca,required=false \
    if grep -q -- '-----BEGIN CERTIFICATE-----' /run/secrets/extra_ca; then cat /run/secrets/extra_ca >> /etc/ssl/certs/ca-certificates.crt; fi
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
ENV NODE_ENV=development

# Toolchain for the Qt port in stag-qt/ (headless tests run with QT_QPA_PLATFORM=offscreen).
RUN apk add --no-cache g++ make cmake samurai qt6-qtbase-dev qt6-qtbase-sqlite qt6-qtdeclarative-dev

WORKDIR /usr/src/app

COPY package.json package-lock.json ./
RUN npm ci && chown -R node:node /usr/src/app/node_modules

COPY . .
