Attribute VB_Name = "frm_debug"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private WithEvents eve_key As key
Attribute eve_key.VB_VarHelpID = -1
Dim DM As Integer
Enum tip_vis
  dec = 0 'visualizzazione dei dati in decimale
  esa = 1 'visualizzazione dei dati in esadecimale
  bin = 2 'visualizzazione dei dati in binario
End Enum
Dim str(0 To 2) As String
Dim vis As tip_vis



Sub fil_pag()
Dim i As Integer

For i = 0 To 99
  lab_dm(i).Caption = CStr(DM + i)
Next i
End Sub


Private Sub eve_key_F1(Shift As Integer)
'cambio data memory
Select Case Shift
  Case 0
  If DM = 3500 Then
      DM = 3600
  Else
      DM = 3500
  End If
  fil_pag
  Case Else
End Select
End Sub

Public Sub msg_box_AddMsg(txt As TextBox, stri As String)
'aggiungo il messaggio alla text_box
  'controllo sulla lunghezza massima
  If Not tim_debug.Enabled Then Exit Sub 'eseguo il debug solo quando il timer è abilitato
  If Len(txt.Text) >= MAX_LEN_TXT Then 'se sono vicino al limite massimo
    txt.Text = Right$(txt.Text, MAX_LEN_TXT \ 10) 'lascio solo gli ultimi caratteri
  End If
  'aggiungo il messaggio alla fine della text_box
  txt.Text = txt.Text + stri
  txt.Text = txt.Text + newline
  txt.SelLength = 0
  txt.SelStart = Len(txt.Text)
End Sub

Private Sub eve_key_F10(Shift As Integer)
'pagina produzione
Select Case Shift
  Case 0
  tim_debug.Enabled = False
  eve_key.chg pag_pro
  Case Else
End Select
End Sub


Private Sub eve_key_F2(Shift As Integer)
'cambio modo di visualizzazione dei dati
Select Case Shift
  Case 0
  vis = (vis + 1) Mod 3
  lab_vis = str(CInt(vis))
  Case Else
End Select
End Sub

Private Sub eve_key_F3(Shift As Integer)
'stop timer
Select Case Shift
  Case 0
  tim_debug.Enabled = False
  Case Else
End Select
End Sub

Private Sub eve_key_F4(Shift As Integer)
Select Case Shift
  Case 0
  'run timer
  If sta_tag.com_OK Then tim_debug.Enabled = True
  Case Else
End Select
End Sub


Private Sub eve_key_F5(Shift As Integer)
Select Case Shift
  Case 0
  'visualizza descrizioni
  tim_debug.Enabled = False
  eve_key.chg frm_debug_des
  Case Else
End Select
End Sub

Private Sub Form_Activate()
lab_vis = str(CInt(vis))
If sta_tag.com_OK Then
    tim_debug.Enabled = True
Else
    del_txt_frm_deb Me
End If
log_box.Text = ""
fil_pag
txt_idle.SetFocus
End Sub

Private Sub Form_Load()
Debug.Print "Inizio Load " & Me.name
disable_tab Me
DM = 3500
vis = dec
str(0) = "Decimale"
str(1) = "Esadecimale"
str(2) = "Binario"
Set eve_key = New key
eve_key.create Me
Carica Me
Debug.Print "Fine Load " & Me.name
Debug.Print ""
End Sub


Private Sub tim_debug_Timer()
Dim ret_sta_plc As Variant
Dim i As Integer
Dim ret As Integer

'ABorelli_FI17/11/2006_1
If val(par_mac.com_plc_lan.abi_lan) = 0 Then
  ret_sta_plc = sta_bar.SYSMAC_PLC.readArea(plcAreaDM, DM, 100, vbVariant Or vbArray)
Else
  sta_bar.Fins.readArea plcAreaDM, DM, 100
  ret_sta_plc = sta_bar.Fins.RetData
End If
For i = 0 To 99
  Select Case vis
    Case 0  'decimale
      txt_dm(i).Text = ret_sta_plc(i)
    Case 1  'esadecimale
      txt_dm(i).Text = int_esa(ret_sta_plc(i))
    Case 2  'binario
      txt_dm(i).Text = hex_bin(int_esa(ret_sta_plc(i)), False)
    End Select
Next i
End Sub


