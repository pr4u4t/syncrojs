{% macro home(data) %}
    <div id="home">
        <div class="row">
            <div style="overflow-x:scroll;">
                <h3> Shift </h3>
                <table class="table mt-4 table-striped">
                    <thead>
                        <tr>
                            <th scope="col"> ID </th>
                            <th scope="col"> Start Time </th>
                            <th scope="col"> End Time </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td> {{ data.Shift.ID }}</td>
                            <td> {{ data.Shift.StartTime }} </td>
                            <td> {{ data.Shift.EndTime }} </td>
                        </tr>
                    </tbody>
                </table>
                <h3> Dry End </h3>
                <table class="table mt-4 table-striped">
                    <thead>
                        <tr>
                            <th scope="col"> Order Level 0 </th>
                            <th scope="col"> Order Level 1 </th>
                            <th scope="col"> Order Level 2 </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <p>{{ data.Orders.Order0.Customer }}</p>
                                <p>
                                    <span>Required: {{data.Orders.Order0.Sheets}}</span>
                                    <span>Good: {{data.Orders.Order0.GoodSheets}}</span>
                                    <span>Bad: {{data.Orders.Order0.BadSheets}}</span>
                                </p>
                            </td>
                            <td>
                                <p>{{ data.Orders.Order1.Customer }}</p>
                                <p>
                                    <span>Required: {{data.Orders.Order1.Sheets}}</span>
                                    <span>Good: {{data.Orders.Order1.GoodSheets}}</span>
                                    <span>Bad: {{data.Orders.Order1.BadSheets}}</span>
                                </p>
                            </td>
                            <td>
                                <p>{{ data.Orders.Order2.Customer }}</p>
                                <p>
                                    <span>Required: {{data.Orders.Order2.Sheets}}</span>
                                    <span>Good: {{data.Orders.Order2.GoodSheets}}</span>
                                    <span>Bad: {{data.Orders.Order2.BadSheets}}</span>
                                </p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endmacro %}
