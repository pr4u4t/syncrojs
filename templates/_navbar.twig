{% macro nav(title) %}
<nav class="navbar navbar-expand-md navbar-dark fixed-top bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">{{title}}</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
          <ul class="navbar-nav me-auto mb-2 mb-md-0" style="width:100%">
            <li class="nav-item">
              <a class="nav-link {% if url == '/' %}active{% endif %}" {% if url == '/' %} aria-current="page" {% endif %} href="/">Home</a>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link {% if url starts with '/past' %}active{% endif %} dropdown-toggle" {% if url starts with '/past' %} aria-current="page" {% endif %} href="#" data-bs-toggle="dropdown" role="button" aria-expanded="false">Past</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="/past/1">Show</a></li>
                <li><a class="dropdown-item" href="/past/export">Export</a></li>
              </ul>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link {% if url starts with '/current' %}active{% endif %} dropdown-toggle" {% if url starts with '/current' %} aria-current="page" {% endif %} href="#" data-bs-toggle="dropdown" role="button" aria-expanded="false">Current</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="/current">Show</a></li>
                <li><a class="dropdown-item" href="/current/import">Import</a></li>
                <li><a class="dropdown-item" href="/current/add">Add</a></li>
              </ul>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link {% if url starts with '/shift' %}active{% endif %} dropdown-toggle" {% if url starts with '/shift' %} aria-current="page" {% endif %} href="#" data-bs-toggle="dropdown" role="button" aria-expanded="false">Shift</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="/Shift">Show</a></li>
                <li><a class="dropdown-item" href="/shift/start">Start</a></li>
                <li><a class="dropdown-item" href="/shift/stop">Stop</a></li>
              </ul>
            </li>
            <li class="nav-item">
              <a class="nav-link {% if url starts with '/papers' %}active{% endif %}" {% if url starts with '/papers' %} aria-current="page" {% endif %}  href="/papers">Papers</a>
            </li>
            <li class="nav-item">
              <a class="nav-link {% if url starts with '/quality' %}active{% endif %}" {% if url starts with '/quality' %} aria-current="page" {% endif %}  href="/quality">Quality</a>
            </li>
            <li class="nav-item">
              <a class="nav-link {% if url starts with '/flute' %}active{% endif %}" {% if url starts with '/flute' %} aria-current="page" {% endif %}  href="/flute">Flute</a>
            </li>
            <li class="nav-item">
              <a class="nav-link {% if url starts with '/settings' %}active{% endif %}" {% if url starts with '/settings' %} aria-current="page" {% endif %}  href="/settings">Settings</a>
            </li>
            <li class="nav-item ms-md-auto">
              <a class="nav-link btn btn-danger d-inline-block"  href="/flush_cache">Flush Cache</a>
            </li>
          </ul>
          
          
        </div>
    </div>
</nav> 
{% endmacro %}
