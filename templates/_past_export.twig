{% macro past_export(url,today) %}
<div id="past_export_form" class="row mt-4">
    <div class="col-12 col-md-6 col-lg-4">
        <h2 class="mt-4">Export past orders as CSV</h2>
        <form action="{{url}}.csv" method="post">
            <div class="mb-3">
                <input type="hidden" name="date" value="{{today}}">
                <button type="submit" class="btn btn-primary">Submit</button>
            </div>
        </form>
    </div>
    <div class="col-12 col-md-6 col-lg-4">
        <h2 class="mt-4">Export past orders as XLSX</h2>
        <form action="{{url}}.xlsx" method="post">
            <div class="mb-3">
                <input type="hidden" name="date" value="{{today}}">
                <button type="submit" class="btn btn-primary">Submit</button>
            </div>
        </form>
    </div>
    <div class="col-12 col-md-6 col-lg-4">
        <h2 class="mt-4">Print/Save as PDF</h2>
        <button class="btn btn-primary" onclick="window.print();">Submit</button>
    </div>
</div> 
{% endmacro %}
