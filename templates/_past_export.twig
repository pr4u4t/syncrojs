{% macro past_export(url) %}
<div class="row mt-4">
    <div class="col-12 col-md-6 col-lg-4">
        <h2 class="mt-4">Export past orders as CSV</h2>
        <form action="{{url}}.csv" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Submit</button>
            </div>
        </form>
    </div>
    <div class="col-12 col-md-6 col-lg-4">
        <h2 class="mt-4">Export past orders as XLSX</h2>
        <form action="{{url}}.xlsx" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Submit</button>
            </div>
        </form>
    </div>
    <div class="col-12 col-md-6 col-lg-4">
        <h2 class="mt-4">Print</h2>
        <button onclick="window.print();">
    </div>
</div> 
{% endmacro %}
