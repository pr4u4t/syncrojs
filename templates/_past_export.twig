{% macro past_export(url) %}
<div class="row mt-4">
    <h2 class="mt-4">Export past orders</h2>
    <form action="{{url}}/export" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Submit</button>
        </div>
    </form>
</div> 
{% endmacro %}
