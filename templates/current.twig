{% extends "layout.twig" %}
{% block title %} Current Orders {% endblock %}
{% block header %} Current Orders {% endblock %}
{% block content %}
	<script type="text/javascript" defer>
        const fetch_orders = async (elem) => {
            const request = async (url) => {
                const response = await fetch(origin+url);
                const ret = await response.text();
                return ret;
            };
            
            const req = await request('/current/orders');
            elem.innerHTML = req;
        };
            
        window.addEventListener("DOMContentLoaded", function() {
            const elem = document.getElementById("orders_all");
            fetch_orders(elem);
        });
	</script>
	<form action="/current/clear" method="post" enctype="multipart/form-data">
		<button type="submit" class="btn btn-danger mt-1">Clear Orders</button>
	</form>
	<hr>
	<div id="orders_all">
		<div class="d-flex justify-content-center">
            <div class="spinner-border" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
          </div>
	</div>
{% endblock %}
