{% extends "layout.twig" %}
{% import "_pagination.twig" as pagination %}

{% block title %}
Orders Import Confirm
{% endblock %}

{% block header %}
Orders Validation Result
{% endblock %}

{% block content %}
<div id="current_confirm" style="overflow-x:scroll;">
  <table class="table mt-4 table-striped">
    <thead class="table-dark">
      <tr>
        <th scope="col">#</th>
        {% for field in fields %}
          <th scope="col">{{ field }} </th>
        {% endfor %}
        <th scope="col">unused</th>
        <th scope="col">unused</th>
        <th scope="col">unused</th>
        <th scope="col">unused</th>
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
        <tr {% if invalid[loop.index0].result == null %} class="table-danger" {% endif %}>
          <td> {{ loop.index }} </td>
          {% for column in row.result %}
            <td>{{ column }}</td>
          {% endfor %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{{ pagination.pagination(total, current, url) }}
<div>
  <h3> Summary: </h3>
  <p>Total/Failed:  {{rows|length}}/{{invalid|length}}</p>
</div>
<form method="post" action="{{url}}" enctype="multipart/form-data">
  <div class="row">
    <div class="col-md-9"></div>
    <div class="col-md-3">
      <button type="submit" class="btn btn-success mt-1 float-end" name="accept" {% if invalid|length > 0 %} disabled {% endif %}>Accept</button>
      <button type="submit" class="btn btn-danger mt-1 float-end me-2" name="deny">Deny</button>
    </div>
  </div>
</form>
{% endblock %}
