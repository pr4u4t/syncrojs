{% extends "layout.twig" %}
{% import "_pagination.twig" as pagination %}

{% block title %}
Orders Import Confirm
{% endblock %}

{% block header %}
Orders Validation Result
{% endblock %}

{% block content %}
  {% if invalid|length > 0 %} 
    <div class="row">
    {% for k, inv in invalid %}
      <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Failed to parse order: {{ k }}</h4>
        <p>{{ inv.error }}</p>
        {# 
          <hr>
          <p class="mb-0">Whenever you need to, be sure to use margin utilities to keep things nice and tidy.</p>
        #}
      </div>
    {%endfor%}
    </div>
  {% endif %}
<div id="current_confirm" style="overflow-x:scroll;">
  <table class="table mt-4 table-striped">
    <thead class="table-dark">
      <tr>
        <th scope="col">#</th>
        {% for field in fields %}
          <th scope="col">{{ field }} </th>
        {% endfor %}
        <th scope="col">unused</th>
        <th scope="col">unused</th>
        <th scope="col">unused</th>
        <th scope="col">unused</th>
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
        <tr {% if invalid[loop.index0] is defined %} class="table-danger" {% endif %}>
          <td> {{ loop.index }} </td>
          {% for column in row %}
            <td>{{ column }}</td>
          {% endfor %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{{ pagination.pagination(total, current, url) }}
<div>
  <h3> Summary: </h3>
  <p>Total/Success/Failed:  {{rows|length}}/{{rows|length - invalid|keys|length}}/{{invalid|keys|length}}</p>
</div>
<form method="post" action="{{url}}" enctype="multipart/form-data">
  <div class="row">
    <div class="col-md-9"></div>
    <div class="col-md-3">
      <button type="submit" class="btn btn-success mt-1 float-end" name="accept" {% if invalid|keys|length > 0 || rows|length - invalid|keys|length == 0 %} disabled {% endif %}>Accept</button>
      <a href="{{url}}" class="btn btn-danger mt-1 float-end me-2" name="deny">Deny</a>
    </div>
  </div>
</form>
{% endblock %}
