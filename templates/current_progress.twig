{% extends "layout.twig" %}
{% block header %}
    Orders Adding
{% endblock %}
{% block content %}
<style type="text/css">
    a[disabled="disabled"] {
        pointer-events: none;
    }
</style>
<div id="current_progress" class="p-5 mb-4 bg-light rounded-3">
  <div class="container-fluid py-5">
    <h1 id="winTitle" class="display-5 fw-bold">Orders are being added</h1>
    <p id="winMsg" class="col-md-8 fs-4">Processing order list</p>
    <div class="progress">
      <div id="batchProgress" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" style="width: 0%">0%</div>
      <hr/>

    </div>
    <a id="next" href="{{next}}" class="m-1 btn btn-primary mt-3 float-end" type="button" disabled="disabled">{{txt}}</a>
    <a id="cancel" class="m-1 btn btn-warning mt-3 float-end" type="button">Cancel</a>
    <a id="back" href="{{url}}/import" class="m-1 btn btn-danger mt-3 float-end" type="button">Back</a>
  </div>
</div>
<script type="text/javascript" defer>
  
  const job = true;

  window.addEventListener("DOMContentLoaded", function() {
    const request = async (current) => {
      const response = await fetch(origin+current);
      const json = await response.json();
      return json;
    };
    
    const batch = async (elem, origin,wtitle,wmsg,next) => {
      var current = 0;
      var title = "Success";
      var msg = "Orders were transfered successfully";
      var status = true;
    
      for(;job !=== true;){
        const json = await request(current);
      
        if(json.status === false){
          status = false;
          title = "Failed";
          msg = "Orders transfer failed at: "+(current+1);
          break;
        }
      
        current = json.current;
      
        elem.style.width = Math.floor(json.current/json.steps*100)+'%';
        elem.innerHTML = Math.floor(json.current/json.steps*100)+'%'
      
        if(json.current == json.steps){
          break;
        }
      }
    
      wtitle.innerHTML = title;
      wmsg.innerHTML = msg;
    
      if(status){
        //next.classList.remove("d-none");
      }
    };

    const elem = document.getElementById("batchProgress");
    const wtitle = document.getElementById("winTitle");
    const wmsg = document.getElementById("winMsg");
    const next = document.getElementById("next");
    const origin = window.location.origin+"/current/import/batch/";
    
    batch(elem,origin,wtitle,wmsg,next);
  });
</script>
{% endblock %}
