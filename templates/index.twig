<!doctype html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap CSS -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <title>{% block title %} Orders {% endblock %}</title>
  </head>
  <body>
    {% import "_navbar.twig" as navbar %}
    {{ navbar.nav("Syncro Orders") }}

    <main class="container mt-5">
      {% block header %}
      <h1>Home Dashboard</h1>
      {% endblock %}
      {% block content %}
        {% import "_home.twig" as home %}
        {{ home.home() }}
      {% endblock %}
    </main>
    <div class="container">
      {% import "_footer.twig" as footer %}
      {{ footer.footer("Syncro Orders") }}
    </div>
    <script src="/js/bootstrap.bundle.min.js"></script>
  </body>
</html>

