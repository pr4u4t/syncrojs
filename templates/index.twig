<!doctype html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap CSS -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <title>Orders</title>
  </head>
  <body>
    <nav class="navbar navbar-expand-md navbar-dark fixed-top bg-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">Syncro Orders</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
          <ul class="navbar-nav me-auto mb-2 mb-md-0">
            <li class="nav-item">
              <a class="nav-link {% if url == '/' %}active{% endif %}" {% if url == '/' %} aria-current="page" {% endif %} href="/">Home</a>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link {% if url starts with '/past' %}active{% endif %} dropdown-toggle" {% if url starts with '/past' %} aria-current="page" {% endif %} href="#" data-bs-toggle="dropdown" role="button" aria-expanded="false">Past</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="/past/1">Show</a></li>
                <li><a class="dropdown-item" href="/past/export">Export</a></li>
              </ul>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link {% if url starts with '/current' %}active{% endif %} dropdown-toggle" {% if url starts with '/current' %} aria-current="page" {% endif %} href="#" data-bs-toggle="dropdown" role="button" aria-expanded="false">Current</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="/current">Show</a></li>
                <li><a class="dropdown-item" href="/current/add">Import</a></li>
              </ul>
            </li>
            <li class="nav-item">
              <a class="nav-link {% if url starts with '/papers' %}active{% endif %}" {% if url starts with '/papers' %} aria-current="page" {% endif %}  href="/papers">Papers</a>
            </li>
            <li class="nav-item">
              <a class="nav-link {% if url starts with '/quality' %}active{% endif %}" {% if url starts with '/quality' %} aria-current="page" {% endif %}  href="/quality">Quality</a>
            </li>
            <li class="nav-item">
              <a class="nav-link {% if url starts with '/flute' %}active{% endif %}" {% if url starts with '/flute' %} aria-current="page" {% endif %}  href="/flute">Quality</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container mt-5">
      {% block content %}
      <div class="row">
          <div class="card mt-5 me-2" style="width:18rem;">
            <img src="/images/orders-current.png" class="card-img-top" alt="current">
            <div class="card-body">
              <h5 class="card-title">Current Orders</h5>
              <p class="card-text" style="height:2em;">View and import current orders</p>
              <a href="/current" class="btn btn-primary">Go to current</a>
            </div>
          </div>
          <div class="card mt-5 me-2" style="width:18rem;">
            <img src="/images/orders-past.png" class="card-img-top" alt="past">
            <div class="card-body">
              <h5 class="card-title">Past Orders</h5>
              <p class="card-text" style="height:2em;">View and export past orders</p>
              <a href="/past/1" class="btn btn-primary">Go to past</a>
            </div>
          </div>
      </div>
      {% endblock %}
    </main>
    <div class="container">
      <footer class="row row-cols-1 row-cols-sm-2 row-cols-md-5 py-5 my-5 border-top">
        <div class="col mb-3">
          <a href="/" class="d-flex align-items-center mb-3 link-dark text-decoration-none">
            Syncro Orders
          </a>
        </div>

        <div class="col mb-3"></div>

        <div class="col mb-3">
          <h5>Home</h5>
          <ul class="nav flex-column">
            <li class="nav-item mb-2"><a href="/" class="nav-link p-0 text-muted">Back to Home</a></li>
          </ul>
        </div>

        <div class="col mb-3">
          <h5>Past</h5>
          <ul class="nav flex-column">
            <li class="nav-item mb-2"><a href="/past/show/1" class="nav-link p-0 text-muted">Show</a></li>
            <li class="nav-item mb-2"><a href="/past/export" class="nav-link p-0 text-muted">Export</a></li>
          </ul>
        </div>

        <div class="col mb-3">
          <h5>Current</h5>
          <ul class="nav flex-column">
            <li class="nav-item mb-2"><a href="/current" class="nav-link p-0 text-muted">Show</a></li>
            <li class="nav-item mb-2"><a href="/current/add" class="nav-link p-0 text-muted">Import</a></li>
          </ul>
        </div>
        
        <div class="col mb-3">
          <h5>Papers</h5>
          <ul class="nav flex-column">
            <li class="nav-item mb-2"><a href="/papers" class="nav-link p-0 text-muted">Papers</a></li>
            {# <li class="nav-item mb-2"><a href="/current/add" class="nav-link p-0 text-muted">Import</a></li> #}
          </ul>
        </div>

        <div class="col mb-3">
          <h5>Papers</h5>
          <ul class="nav flex-column">
            <li class="nav-item mb-2"><a href="/quality" class="nav-link p-0 text-muted">Quality</a></li>
            {# <li class="nav-item mb-2"><a href="/current/add" class="nav-link p-0 text-muted">Import</a></li> #}
          </ul>
        </div>
        
        <div class="col mb-3">
          <h5>Papers</h5>
          <ul class="nav flex-column">
            <li class="nav-item mb-2"><a href="/flute" class="nav-link p-0 text-muted">Flute</a></li>
            {# <li class="nav-item mb-2"><a href="/current/add" class="nav-link p-0 text-muted">Import</a></li> #}
          </ul>
        </div>
        
      </footer>
    </div>
    <!-- Optional JavaScript; choose one of the two! -->

    <!-- Option 1: Bootstrap Bundle with Popper -->
    <script src="/js/bootstrap.bundle.min.js"></script>

    <!-- Option 2: Separate Popper and Bootstrap JS -->
    <!--
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js" integrity="sha384-IQsoLXl5PILFhosVNubq5LC7Qb9DXgDA9i+tQ8Zj3iwWAwPtgFTxbJ8NT4GN1R8p" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.min.js" integrity="sha384-cVKIPhGWiC2Al4u+LWgxfKTRIcfu0JTxR+EQDz/bgldoEyl4H0zUF0QKbrJ0EcQF" crossorigin="anonymous"></script>
    -->
  </body>
</html>

