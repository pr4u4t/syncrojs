{% extends "layout.twig" %}
{% block title %}
    Home Dashboard
{% endblock %}

{% block header %}
    Home dashboard
{% endblock %}
{% block content %}
    <script type="text/javascript" defer>
        const fetch_home = async (elem) => {
            const request = async (url) => {
                const response = await fetch(origin+url);
                const ret = await response.text();
                return ret;
            };
                
                
            const req = await request('/home_info');
            elem.innerHTML = req;
        };
            
        window.addEventListener("DOMContentLoaded", function() {
            const elem = document.getElementById("home_info");
            fetch_home(elem);
        });
    </script>
        <div id="home_info">
          <div class="d-flex justify-content-center">
            <div class="spinner-border" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
          </div>
        </div>
        <div class="row">
            <div class="card mt-5 me-2" style="width:18rem;">
                <img src="/images/orders-current.png" class="card-img-top" alt="current">
                <div class="card-body">
                <h5 class="card-title">Current Orders</h5>
                <p class="card-text" style="height:2em;">View and import current orders</p>
                <a href="/current" class="btn btn-primary">Go to current</a>
                </div>
            </div>
            <div class="card mt-5 me-2" style="width:18rem;">
                <img src="/images/orders-past.png" class="card-img-top" alt="past">
                <div class="card-body">
                <h5 class="card-title">Past Orders</h5>
                <p class="card-text" style="height:2em;">View and export past orders</p>
                <a href="/past/1" class="btn btn-primary">Go to past</a>
                </div>
            </div>
        </div>
{% endblock %}