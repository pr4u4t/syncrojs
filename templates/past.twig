{% extends "index.twig" %}
{% import "_pagination.twig" as pagination %}

{% block title %}
{{ title }}
{% endblock %}

{% block header %}
{{ header_title }}
{% endblock %}

{% block content %}
<div style="overflow-x:scroll;">
  <table class="table mt-4 table-striped">
    <thead class="table-dark">
      <tr>
        {% for field in fields %}
          <th scope="col">{{ field.name }} </th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
        <tr>
          {% for column in row %}
            <td>{{ column }}</td>
          {% endfor %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{{ pagination.pagination(total, current, url) }}
{% endblock %}
