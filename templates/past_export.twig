{% extends "index.twig" %}
{% import "_past_export.twig" as past_export %}
{% block title %}
Past Order Export 
{% endblock %}

{% block header %}
Past Order Export
{% endblock %}

{% block content %}
<div style="overflow-x:scroll;">
  <table class="table mt-4 table-striped">
    <thead class="table-dark">
      <tr>
        {% for field in fields %}
          <th scope="col">{{ field.name }} </th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
        <tr>
          {% for column in row %}
            <td>{{ column }}</td>
          {% endfor %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{{ past_export.past_export(url) }}
{% endblock %}
