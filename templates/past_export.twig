{% extends "layout.twig" %}
{% import "_past_export.twig" as past_export %}
{% block title %}
Past Order Export 
{% endblock %}

{% block header %}
Past Order Export
{% endblock %}

{% block content %}
<div id="past_export" style="overflow-x:scroll;">
  <table class="table mt-4 table-striped">
    <thead class="table-dark">
      <tr>
        {% for field in fields %}
          <th scope="col">{{ field.name }} </th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
        <tr>
          {% for column in row %}
            <td>{{ column }}</td>
          {% endfor %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<form action="{{url}}" type="get" id="go_to_date">
  <h4> Go to date </h4>
  <input name="date" type="date" value="{{today}}" />
  <button type="submit" class="btn btn-primary">Submit</button>
</form>
<hr/>
{{ past_export.past_export(url,today) }}
{% endblock %}
