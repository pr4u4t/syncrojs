{% extends "index.twig" %}


{% block title %}
  {{ title }}
{% endblock %}

{% block header %}
  {{ header_title }}
{% endblock %}

{% block content %}
<div id="settings">
  <div class="alert alert-warning" role="alert">
    Warning some of the changes may require manual service restart from terminal
  </div>

  <form action="{{url}}save" method="post" enctype="multipart/form-data">
    {% for field in fields %}

      <div class="mb-3">
        <label for="{{ field.path }}" class="form-label">{{ field.path }}</label>
        <input class="form-control" type="text" id="{{ field.path }}" name="{{ field.path }}" value="{{ field.conf }}">
      </div>
    {% endfor %}
    <button type="submit" class="btn btn-primary">Save</button>
  </form>
</div>
{% endblock %}
