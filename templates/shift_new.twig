{% extends "layout.twig" %}
{% import "_pagination.twig" as pagination %}

{% block title %}
Shift Start
{% endblock %}

{% block header %}
Shift Start
{% endblock %}

{% block content %}

<div id="shift_new" class="row mt-4">
    <div class="col-md-6">
        <h2 class="mt-4">New Shift</h2>
        <form action="{{url}}start" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="ID" class="form-label">ID</label>
                <input class="form-control" type="number" min="1" max="9" id="ID" name="ID">
                <label for="manager" class="form-label">Manager</label>
                <input class="form-control" type="text" id="manager" name="manager">
				<label for="people" class="form-label">People</label>
                <input class="form-control" type="number" min="1" id="people" name="people">
                <button type="submit" class="btn btn-primary mt-1">Submit</button>
            </div>
        </form>
    </div>
</div>

{% endblock %}
